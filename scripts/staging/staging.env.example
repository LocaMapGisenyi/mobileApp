# Copy to scripts/staging/.env.staging.local, already ignored by .gitignore.
# Fill only after confirming the target in the Supabase dashboard / CLI.
# Do not put this file or real credentials in a PR, issue, chat or screenshot.
LOCAMAP_STAGING_PROJECT_REF=
LOCAMAP_STAGING_URL=
LOCAMAP_STAGING_VERIFICATION=
# If this is also EXPO_PUBLIC_SUPABASE_URL from .env, explicit acknowledgement:
# LOCAMAP_STAGING_ALLOW_APP_TARGET=verified-staging:<same-project-ref>
LOCAMAP_STAGING_ALLOW_APP_TARGET=
# Comma-separated known production refs; any match is always refused.
LOCAMAP_PRODUCTION_PROJECT_REFS=

# The plan command needs only the target fields above.
# The smoke preflight and --run additionally need every field below.
# Use only the anon JWT or sb_publishable key, never service_role/sb_secret.
LOCAMAP_STAGING_ANON_KEY=
LOCAMAP_SMOKE_IDENTITIES=
# Unique per fixture/run, e.g. locamap-smoke-20260930-001.
LOCAMAP_SMOKE_RUN_ID=
LOCAMAP_SMOKE_PROPERTY_ID=
# YYYY-MM-DD: start tomorrow or later; at least min_duration_months * 30 days.
LOCAMAP_SMOKE_START_DATE=
LOCAMAP_SMOKE_END_DATE=

# Three existing, confirmed, dedicated test accounts, all different.
# Emails must start with locamap-smoke+ / locamap-smoke- / locamap-smoke.
LOCAMAP_SMOKE_HOST_ID=
LOCAMAP_SMOKE_HOST_EMAIL=
LOCAMAP_SMOKE_HOST_PASSWORD=
LOCAMAP_SMOKE_GUEST_ID=
LOCAMAP_SMOKE_GUEST_EMAIL=
LOCAMAP_SMOKE_GUEST_PASSWORD=
LOCAMAP_SMOKE_STRANGER_ID=
LOCAMAP_SMOKE_STRANGER_EMAIL=
LOCAMAP_SMOKE_STRANGER_PASSWORD=
