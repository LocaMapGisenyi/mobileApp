# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Leave empty for the native variant or Expo Go to construct its own URL.
# Add that exact URL to the Supabase Auth redirect allowlist.
# For web use your https://app.example/auth/recovery URL and configure SPA fallback.
EXPO_PUBLIC_AUTH_REDIRECT_URL=

# iPhone: Apple Maps through react-native-maps, no Google key required.
# Android: Google Maps; use a restricted key for signed builds (not EXPO_PUBLIC).
GOOGLE_MAPS_ANDROID_API_KEY=
# Web: MapLibre with TomTom Orbis Maps. Use a TomTom key restricted to the site.
EXPO_PUBLIC_TOMTOM_MAPS_API_KEY=

# Real support contacts; omitted channels are unavailable in the app.
EXPO_PUBLIC_SUPPORT_EMAIL=peter23xp@gmail.com
EXPO_PUBLIC_SUPPORT_PHONE=
EXPO_PUBLIC_SUPPORT_WHATSAPP=250782028955
EXPO_PUBLIC_DPO_EMAIL=

# R2 (used by Edge Function secrets only — NEVER in the app)
# Set via: supabase secrets set R2_ACCOUNT_ID=xxx
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=locamap-staging-public
# R2_PRIVATE_BUCKET_NAME=locamap-staging-private
# R2_PUBLIC_URL=https://your-public-bucket.r2.dev
# ALLOWED_ORIGINS=http://localhost:8097,http://127.0.0.1:8097
# STORAGE_CLEANUP_SECRET=generate-a-random-server-secret-at-least-32-characters
